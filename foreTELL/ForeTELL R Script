# Security & Vector Analysis

## Attack Signature Detection (SQLi, Traversal, RCE)

```{r attack-signatures}
suspicious_patterns <- "(?i)union\\s+select|sleep\\(|benchmark\\(|\\.\\./\\.\\.|\\.\\./|cmd=|exec=|passthru|eval\\(|base64_decode|<script|\\bOR\\b\\s+1=1"
suspicious_uris <- log[str_detect(uri, suspicious_patterns), .N, by = .(ip, uri)][order(-N)]

if (nrow(suspicious_uris) > 0) {
  datatable(suspicious_uris, options = dt_opts, caption = "Web Application Attack Signatures Detected")
} else {
  cat("No attack payload patterns matched in this log window.")
}
```

## Excessive 404 Activity by IP (Scanner / Enumeration Detection)

```{r scanner-detection}
ip_404 <- log[status == 404, .(not_found_count = .N, unique_uris = uniqueN(uri)), by = ip][order(-not_found_count)]

if (nrow(ip_404) > 0) {
  datatable(ip_404[1:min(50, nrow(ip_404))], options = dt_opts,
            caption = "Top IPs by 404 Volume — Directory Enumeration Indicator")
} else {
  cat("No 404 activity detected.")
}
```

## Large Outbound Response Payloads (Exfiltration Screening)

```{r large-payloads}
if (bytes_available) {
  large_thresh    <- quantile(log$bytes, 0.99, na.rm = TRUE)
  large_responses <- log[bytes > large_thresh, .(ip, time, uri, status, bytes)][order(-bytes)]

  datatable(
    large_responses[1:min(50, nrow(large_responses))],
    options = dt_opts,
    caption = paste0("Outbound Response Size Anomalies (99th Percentile — threshold: ",
                     format(round(large_thresh), big.mark = ",", scientific = FALSE), " bytes)")
  )
} else {
  cat("Byte size data not available in this log.")
}
```

