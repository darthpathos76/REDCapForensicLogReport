# Traffic Overview

## Recent Requests (Latest 20)

```{r recent-requests}
display_cols <- c("ip", "time", "method", "uri", "status", "bytes")
datatable(
  log[order(-time)][1:min(20, nrow(log)), ..display_cols],
  options = dt_opts,
  caption = "Twenty most recent access log entries"
)
```

## Requests per Hour

```{r requests-per-hour, fig.width=10, fig.height=4}
hourly_traffic <- log[!is.na(req_hour), .N, by = req_hour][order(req_hour)]

if (nrow(hourly_traffic) > 1) {
  ggplot(hourly_traffic, aes(x = req_hour, y = N)) +
    geom_line(colour = "#2C7BB6", linewidth = 0.8) +
    geom_area(fill = "#2C7BB6", alpha = 0.12) +
    scale_x_datetime(labels = date_format("%b %d\n%H:%M"), date_breaks = "6 hours") +
    scale_y_continuous(labels = comma) +
    labs(title = "Requests per Hour", x = NULL, y = "Request Count") +
    theme_minimal(base_size = 12)
} else {
  cat("Insufficient data for hourly traffic chart (need more than one hour of logs).")
}
```

