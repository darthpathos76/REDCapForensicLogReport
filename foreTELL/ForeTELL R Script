# Report Summary

```{r report-summary}
summary_rows <- data.frame(
  Metric = c(
    "Log file parsed",
    "Total requests",
    "Date range (start)",
    "Date range (end)",
    "Unique IPs",
    "Apache error log loaded",
    "PHP error log loaded"
  ),
  Value = c(
    apache_access_file,
    format(nrow(log), big.mark = ","),
    format(min(log$time, na.rm = TRUE), "%Y-%m-%d %H:%M UTC"),
    format(max(log$time, na.rm = TRUE), "%Y-%m-%d %H:%M UTC"),
    format(uniqueN(log$ip), big.mark = ","),
    ifelse(nrow(ap_err_dt) > 0, paste0("Yes (", format(nrow(ap_err_dt), big.mark=","), " entries)"), "No / empty"),
    ifelse(nrow(php_dt)    > 0, paste0("Yes (", format(nrow(php_dt),    big.mark=","), " entries)"), "No / empty")
  ),
  stringsAsFactors = FALSE
)

knitr::kable(summary_rows, col.names = c("Metric", "Value"), align = c("l", "l"))
