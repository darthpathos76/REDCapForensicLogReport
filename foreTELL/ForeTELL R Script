```{r setup, include=FALSE}
knitr::opts_chunk$set(
  echo    = FALSE,
  warning = FALSE,
  message = FALSE
)

# ------------------------------
# Packages
# ------------------------------
packages <- c("data.table", "tidyverse", "lubridate", "stringr", "DT", "ggplot2", "scales")
missing  <- packages[!sapply(packages, requireNamespace, quietly = TRUE)]
if (length(missing)) {
  stop("Please install required packages before knitting: ",
       paste(missing, collapse = ", "))
}
lapply(packages, library, character.only = TRUE)

# ------------------------------
# Path Configuration
# Update these paths for each environment before knitting
# ------------------------------
apache_access_file <- "C:/REDCap ForeTELL Logs/access.log"
apache_error_file  <- "C:/REDCap ForeTELL Logs/apache_error.log"
php_log_file       <- "C:/REDCap ForeTELL Logs/php_error.log"

# ------------------------------
# Parse Apache Access Log
# ------------------------------
if (!file.exists(apache_access_file)) {
  stop("Missing core Apache access log: ", apache_access_file)
}

logs <- readLines(apache_access_file, warn = FALSE)
log  <- data.table(raw = logs)
log[, raw := str_replace_all(raw, '^"|"$', '')]
log[, raw := str_trim(raw)]
log  <- log[str_detect(raw, "^::1|^\\d{1,3}(\\.\\d{1,3}){3}")]

split_cols <- tstrsplit(log$raw, " ", fixed = TRUE)
log[, ip        := split_cols[[1]]]
log[, time      := str_extract(raw, "\\d{2}/[A-Za-z]{3}/\\d{4}:\\d{2}:\\d{2}:\\d{2} [-+]\\d{4}")]
log[, time      := as.POSIXct(time, format = "%d/%b/%Y:%H:%M:%S %z", tz = "UTC")]
log[, request   := str_replace_all(str_extract(raw, '"(.*?)"'), '"', '')]
log[, status    := as.integer(str_extract(raw, '(?<=\\s)(\\d{3})(?=\\s)'))]
log[, method    := str_extract(request, "^\\S+")]
log[, uri       := str_extract(request, "(?<=\\s)\\S+(?=\\s)")]
log[, protocol  := str_extract(request, "\\S+$")]
log[, bytes     := as.integer(str_extract(raw, '(?<=\\s\\d{3}\\s)\\d+'))]

log <- log[, .(ip, time, method, uri, protocol, status, bytes, raw)]

log[, req_hour        := lubridate::floor_date(time, "hour")]
log[, req_minute      := lubridate::floor_date(time, "minute")]
log[, dow             := as.character(lubridate::wday(time, label = TRUE, abbr = TRUE))]
log[, req_hour_of_day := lubridate::hour(time)]

log[, status_cat := fcase(
  !is.na(status) & status >= 200 & status < 300, "2xx Success",
  !is.na(status) & status >= 300 & status < 400, "3xx Redirect",
  !is.na(status) & status >= 400 & status < 500, "4xx Client Error",
  !is.na(status) & status >= 500,                "5xx Server Error",
  default = "Other"
)]

log[, uri_stem   := str_extract(uri, "^[^?#]+")]
log[, uri_length := nchar(uri)]

log[, user_agent := str_replace_all(str_extract(raw, '"([^"]+)"$'), '"', '')]
log[, ua_category := fcase(
  is.na(user_agent) | user_agent %in% c("-", ""), "Empty / Missing",
  str_detect(user_agent, "(?i)Mozilla|Chrome|Safari|Firefox|Edge|Opera"), "Browser",
  str_detect(user_agent, "(?i)bot|crawler|spider|slurp|googlebot|bingbot|curl|wget|python|java|go-http|libwww"), "Bot / Tool / Scanner",
  default = "Unknown / Custom"
)]

refs_all <- str_extract_all(log$raw, '"([^"]*)"')
log[, referrer := vapply(
  refs_all,
  function(x) if (length(x) >= 2L) x[[2L]] else NA_character_,
  FUN.VALUE = character(1L)
)]

bytes_available <- log[!is.na(bytes) & bytes > 0, .N] > 0

# ------------------------------
# Parse Apache Error Log
# ------------------------------
ap_err_dt <- data.table()

if (file.exists(apache_error_file)) {
  ap_err_raw     <- readLines(apache_error_file, warn = FALSE)
  ap_err_pattern <- '^\\[([^\\]]+)\\]\\s+\\[([^\\]]+)\\]\\s+\\[pid[^\\]]+\\]\\s+(?:\\[client\\s+([^\\]]+)\\]\\s+)?(.*)$'
  ap_err_match   <- stringr::str_match(ap_err_raw, ap_err_pattern)

  if (!is.null(ap_err_match) && ncol(ap_err_match) >= 5) {
    ap_err_df              <- as.data.frame(ap_err_match, stringsAsFactors = FALSE)
    colnames(ap_err_df)    <- c("full", "datetime", "level_mod", "client_ip", "message")
    ap_err_df              <- ap_err_df[, c("datetime", "level_mod", "client_ip", "message")]
    ap_err_df$datetime     <- lubridate::parse_date_time(
      ap_err_df$datetime,
      orders = c("a b d H:M:S.Y", "a b d H:M:S z Y"),
      tz = "UTC"
    )
    ap_err_df  <- ap_err_df[!is.na(ap_err_df$message), ]
    ap_err_dt  <- as.data.table(ap_err_df)
    ap_err_dt[, req_hour := floor_date(datetime, "hour")]
  }
}

# ------------------------------
# Parse PHP Error Log
# ------------------------------
php_dt <- data.table()

if (file.exists(php_log_file)) {
  php_logs    <- readLines(php_log_file, warn = FALSE, encoding = "UTF-8")
  php_pattern <- '^\\[([^\\]]+)\\]\\s+PHP\\s+([^:]+):\\s+(.*)$'
  m           <- stringr::str_match(php_logs, php_pattern)

  if (!is.null(m) && ncol(m) >= 4) {
    php_df           <- as.data.frame(m, stringsAsFactors = FALSE)
    colnames(php_df) <- c("full", "datetime", "type", "message")
    php_df           <- php_df[, c("datetime", "type", "message")]
    php_df$datetime  <- lubridate::parse_date_time(
      php_df$datetime,
      orders = c("d-b-Y H:M:S", "d-b-Y H:M:S z", "Y-m-d H:M:S"),
      tz = "UTC"
    )
    php_df <- php_df[!is.na(php_df$type) & !is.na(php_df$message), ]
    php_dt <- as.data.table(php_df)
    php_dt[, req_hour := floor_date(datetime, "hour")]
  }
}

# Shared DT options
dt_opts <- list(pageLength = 25, scrollX = TRUE, class = "compact stripe hover")
```

