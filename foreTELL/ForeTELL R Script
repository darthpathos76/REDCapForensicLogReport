# Cross-Log Correlation

## Unified Stack Correlation Timeline

```{r correlation-matrix}
acc_5xx      <- log[!is.na(status) & status >= 500, .(Apache_5xx = .N), by = req_hour]
err_hourly_c <- if (nrow(ap_err_dt) > 0) ap_err_dt[, .(Apache_Errors = .N), by = req_hour] else
                data.table(req_hour = as.POSIXct(character()), Apache_Errors = integer())
php_hourly_c <- if (nrow(php_dt) > 0) php_dt[, .(PHP_Errors = .N), by = req_hour] else
                data.table(req_hour = as.POSIXct(character()), PHP_Errors = integer())

corr_matrix <- merge(acc_5xx, err_hourly_c, by = "req_hour", all = TRUE)
corr_matrix <- merge(corr_matrix, php_hourly_c, by = "req_hour", all = TRUE)
corr_matrix[is.na(corr_matrix)] <- 0L
corr_matrix <- corr_matrix[order(req_hour)]

if (nrow(corr_matrix) > 0) {
  datatable(corr_matrix, options = dt_opts,
            caption = "Hourly Correlation: Apache 5xx vs Apache Errors vs PHP Errors")
} else {
  cat("No 5xx events detected. No cross-log correlation data to display.")
}
```

