# REDCap-Specific Monitoring

## Endpoint Health Matrix

```{r redcap-endpoints}
redcap_endpoints <- log[
  str_detect(uri_stem, "(?i)/api/|redcap_v|esignature|surveys/|DataEntry|record_home|FileRepository"),
  .(
    hits       = .N,
    unique_ips = uniqueN(ip),
    pct_errors = round(mean(status >= 400, na.rm = TRUE) * 100, 1)
  ),
  by = .(endpoint = uri_stem)
][order(-hits)]

if (nrow(redcap_endpoints) > 0) {
  datatable(redcap_endpoints, options = dt_opts, caption = "REDCap Native Endpoint Health Matrix")
